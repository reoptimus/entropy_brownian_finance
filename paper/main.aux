\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces FF49: $H^{cov}_t=\tfrac  12\log \det \Sigma _t$. Visible drops coincide with the stress episodes listed above (2000--2002, 2008, 2020, 2022).}}{8}{}\protected@file@percent }
\newlabel{fig:ff49-logdet}{{3}{8}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Does compensation hold within, and not just across, crises?}{8}{}\protected@file@percent }
